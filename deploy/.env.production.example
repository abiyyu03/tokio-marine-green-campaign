# Template .env untuk shared hosting tanpa SSH / cron.
# Salin isinya ke /home/USER/laravel/.env lewat cPanel File Manager.
#
# JANGAN menyalin mentah dari .env.example di root repo: file itu memakai
# QUEUE_CONNECTION=database yang butuh `queue:work`, dan worker itu mustahil
# dijalankan tanpa SSH maupun cron.

APP_NAME="Tokio Marine Green Campaign"
APP_ENV=production
# Hasilkan key BARU dengan `php artisan key:generate --show` di lokal.
# Jangan memakai ulang key development.
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-anda.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# `daily` memangkas sendiri log lama lewat LOG_DAILY_DAYS. Channel `single`
# akan tumbuh selamanya karena tidak ada cron untuk merotasinya.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=userxxx_greencamp
DB_USERNAME=userxxx_greencamp
DB_PASSWORD=

# Pindah dari `file` ke `database`. Driver file menulis satu berkas per
# pengunjung ke storage/framework/sessions, dan paket shared hosting punya
# batas inode meski storage-nya diiklankan unlimited. Tabel `sessions` dan
# `cache` sudah tersedia di migration bawaan Laravel, jadi nol kerja tambahan.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database

# WAJIB tetap sync. Tanpa SSH dan tanpa cron, tidak ada proses yang bisa
# menjalankan `queue:work`, sehingga job apa pun akan menumpuk tanpa pernah
# dieksekusi kalau driver-nya diganti.
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Fitur kirim laporan ke email lead belum dibangun. Saat nanti dibuat, isi
# dengan kredensial akun email cPanel (paket ini menyediakan email tak
# terbatas) dan ingat bahwa queue `sync` membuat pengiriman terjadi di dalam
# request — tombol terakhir wizard akan terasa lebih lambat.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@domain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"

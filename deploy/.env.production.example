# Template .env untuk shared hosting tanpa SSH / cron.
# Salin isinya ke /home/USER/laravel/.env lewat cPanel File Manager.
#
# JANGAN menyalin mentah dari .env.example di root repo: file itu memakai
# QUEUE_CONNECTION=database yang butuh `queue:work`, dan worker itu mustahil
# dijalankan tanpa SSH maupun cron.

APP_NAME="Tokio Marine Green Campaign"
APP_ENV=production
# Hasilkan key BARU dengan `php artisan key:generate --show` di lokal.
# Jangan memakai ulang key development.
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-anda.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# `daily` memangkas sendiri log lama lewat LOG_DAILY_DAYS. Channel `single`
# akan tumbuh selamanya karena tidak ada cron untuk merotasinya.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=userxxx_greencamp
DB_USERNAME=userxxx_greencamp
DB_PASSWORD=

# Pindah dari `file` ke `database`. Driver file menulis satu berkas per
# pengunjung ke storage/framework/sessions, dan paket shared hosting punya
# batas inode meski storage-nya diiklankan unlimited. Tabel `sessions` dan
# `cache` sudah tersedia di migration bawaan Laravel, jadi nol kerja tambahan.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database

# WAJIB tetap sync. Tanpa SSH dan tanpa cron, tidak ada proses yang bisa
# menjalankan `queue:work`, sehingga job apa pun akan menumpuk tanpa pernah
# dieksekusi kalau driver-nya diganti.
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Email hasil kalkulator (dikirim otomatis begitu wizard selesai).
#
# Pakai akun email cPanel milik domain ini — paket hosting menyediakan email
# tak terbatas, dan pengiriman dari server yang sama dengan domain pengirim
# membuat SPF/DKIM cocok sehingga jarang masuk spam. Buat mailbox lewat
# cPanel > Email Accounts, lalu isi di bawah.
#
# MAIL_HOST: hostname mail server hosting (biasanya mail.domain-anda.com).
# Dua kombinasi yang lazim, pilih SALAH SATU:
#   - SSL   : MAIL_PORT=465, MAIL_SCHEME=smtps
#   - TLS   : MAIL_PORT=587, MAIL_SCHEME=smtp   (STARTTLS)
#
# MAIL_FROM_ADDRESS WAJIB sama dengan MAIL_USERNAME. Hampir semua SMTP
# hosting menolak mengirim atas nama alamat lain, dan penolakannya baru
# terlihat sebagai baris error di storage/logs.
#
# Queue tetap `sync`, jadi pengiriman terjadi di dalam request yang menekan
# tombol terakhir wizard: langkah itu akan terasa lebih lambat 1-3 detik.
# Kalau SMTP gagal, hasil peserta tetap tersimpan dan halaman hasil tetap
# terbuka — kegagalannya dicatat di storage/logs/laravel-*.log.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.domain-anda.com
MAIL_PORT=465
MAIL_USERNAME=noreply@domain-anda.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@domain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"
